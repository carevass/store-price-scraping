SUPERSET_DB_PASSWORD = password for the postgres metadata db

PG_HOST = name the host for postgres
PG_USER = username for postgres
PG_PASSWORD = password for postgres
PG_DATABASE = name the database with the scraping data
PG_PORT = 5432

