SUPERSET_SECRET_KEY = apache superset key
SUPERSET_DB_PASSWORD = password for the postgres metadata db

PG_HOST = name the host for postgres
PG_USER = username for postgres
PG_PASSWORD = password for postgres
PG_DATABASE = name the database with the scraping data
PG_PORT = 5432

STORE1_STARTLINK = Link to page to start scraping from here
STORE2_STARTLINK = Structure of API URL here
STORE3_STARTLINK = Link for store 3
STORE3_AUTH = Authentication token for store 3
STORE3_HOST = API host name for header store 3

AIRFLOW_PROJ_DIR = ./airflow
AIRFLOW_UID=50000
